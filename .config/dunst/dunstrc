[global]
    monitor = 0
    follow = mouse
    width = (300, 420)
    height = (0, 300)
    origin = top-right
    offset = (12, 46)
    scale = 0
    notification_limit = 6

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    transparency = 10
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#89b4fa"
    corner_radius = 10
    gap_size = 6

    font = FiraCode Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = "breeze-dark, hicolor"

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#1e1e2eee"
    foreground = "#a6adc8"
    frame_color = "#585b70"
    timeout = 5

[urgency_normal]
    background = "#1e1e2eee"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 8

[urgency_critical]
    background = "#1e1e2eee"
    foreground = "#cdd6f4"
    frame_color = "#fab387"
    timeout = 0
