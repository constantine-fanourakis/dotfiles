[Unit]
Description=Daily Bing wallpaper refresh

[Timer]
OnCalendar=daily
# Catch up after the laptop has been asleep or powered off, instead of
# silently skipping the missed run.
Persistent=true
# Bing publishes at 00:00 UTC; jitter avoids hammering it on the dot and
# keeps the fetch off the critical path at login.
RandomizedDelaySec=30m
# Also refresh shortly after login, so a machine that is rarely up at the
# scheduled time still gets a current image.
OnStartupSec=2min

[Install]
WantedBy=timers.target
